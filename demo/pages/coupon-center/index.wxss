.coupon-center-header{display:flex;align-items:center;gap:16rpx;justify-content:space-between;padding:10rpx 0 24rpx}.coupon-center .top-title{font-size:36rpx;letter-spacing:0}.coupon-center .sub-title{font-size:23rpx}.coupon-header-icon{width:94rpx;height:94rpx;display:flex;align-items:center;justify-content:center;background:#eef0f6;border-radius:20rpx;flex-shrink:0}.coupon-offer{display:flex;align-items:center;padding:32rpx 22rpx;margin-top:22rpx;gap:16rpx}.coupon-offer-amount{font-size:57rpx;font-weight:650;color:var(--primary);min-width:127rpx;letter-spacing:-1rpx}.coupon-offer-amount text{font-size:25rpx;margin-right:4rpx}.coupon-offer-copy{flex:1;font-size:27rpx;font-weight:500}.coupon-offer-copy .card-note{font-weight:400;font-size:21rpx;line-height:1.8}.coupon-claim{padding:13rpx 18rpx;color:#fff;background:var(--primary);border-radius:28rpx;font-size:22rpx;white-space:nowrap;flex-shrink:0}.coupon-claim.claimed{color:#9098af;background:#f0f2f8}.coupon-mine{margin-top:32rpx;width:100%;font-size:26rpx}
