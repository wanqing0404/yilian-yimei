<view class="page category"><brand-header></brand-header><view class="search-wrap"><ui-icon name="search" size="32"></ui-icon><input class="search-input" placeholder="搜索项目、品牌或内容" value="{{keyword}}" bindinput="search" confirm-type="search"></input><button wx:if="{{keyword}}" bindtap="clearSearch" class="search-clear" aria-label="清空搜索"><ui-icon name="close" size="26"></ui-icon></button></view><view class="category-nav-row"><button id="category-0" class="category-item category-all {{selected === '全部' ? 'selected' : ''}}" data-name="全部" bindtap="selectCategory">全部</button><scroll-view class="category-top-nav" scroll-x="{{true}}" show-scrollbar="{{false}}" enhanced="{{true}}" scroll-into-view="{{selectedIndex > 0 ? 'category-' + selectedIndex : ''}}" scroll-with-animation="{{true}}"><view class="category-top-inner"><button wx:for="{{scrollCategories}}" wx:key="*this" id="category-{{index + 1}}" class="category-item {{selected === item ? 'selected' : ''}}" data-name="{{item}}" bindtap="selectCategory">{{item}}</button></view></scroll-view></view><view class="catalogue"><scroll-view class="product-scroll" scroll-y="{{true}}" bindtouchstart="touchStart" bindtouchend="touchEnd" bindtouchcancel="touchCancel"><view class="product-grid"><view class="product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct"><button class="product-image" data-id="{{item.id}}" catchtap="openProduct"><media-placeholder src="{{item.thumbnail}}" lazy="{{index >= 4}}" label="项目图片" kind="product" fit="aspectFill" blank="{{true}}"></media-placeholder></button><view class="product-info"><button class="product-name" data-id="{{item.id}}" catchtap="openProduct">{{item.name}}</button><view class="product-desc">{{item.desc}}</view><view class="between"><text class="price"><text wx:if="{{item.priceType === '定金'}}" class="deposit-label">定金</text><text wx:for="{{item.priceParts}}" wx:for-item="part" wx:key="*this" class="{{part === '¥' || part === '积分' || part === '+' ? 'product-price-unit' : ''}}">{{part}}</text></text><button class="cart-button" catchtap="addToCart" data-id="{{item.id}}" aria-label="加入购物车"><ui-icon name="cart" size="34" active="{{true}}"></ui-icon></button></view></view></view></view><view class="empty" wx:if="{{products.length === 0}}"><ui-icon name="search" size="54"></ui-icon><view class="empty-title">暂无相关项目</view><text>试试其他关键词或分类</text></view><view class="catalogue-end" wx:if="{{products.length}}">已展示全部项目</view></scroll-view></view></view>
