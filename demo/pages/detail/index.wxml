<view class="page product-detail"><brand-header back="{{true}}" title="商品详情"></brand-header><view wx:if="{{product}}"><view class="detail-gallery"><media-placeholder src="{{product.image}}" label="商品主图待补充" fit="aspectFill" blank="{{true}}" kind="product"></media-placeholder><view class="gallery-counter">{{imageIndex}}/{{imageCount}}</view></view><view class="product-summary"><view wx:if="{{activityLabel}}" class="detail-activity-label"><text class="pill">{{activityLabel}}</text><text class="muted small">日常示例价 ¥{{originalPrice}}</text></view><view class="between"><view class="detail-price"><text wx:if="{{product.priceType === '定金'}}" class="detail-deposit-label">定金 </text><text wx:for="{{priceParts}}" wx:for-item="part" wx:key="*this" class="{{part === '¥' || part === '积分' || part === '+' ? 'product-price-unit' : ''}}">{{part}}</text></view><text class="stock">还剩{{product.stock}}件</text></view><view class="paid">{{product.paid}}人付款</view><view class="detail-name">{{product.name}}</view></view><view class="invite-section"><view><view class="invite-title">邀请好友</view><view class="invite-description">好友消费后您可得<text>10BP</text></view><button class="invite-button" open-type="share">立即邀请</button></view><view class="invite-art"><media-placeholder label="邀请活动配图" src="/assets/images/invite-friends-10bp.jpg" fit="aspectFit"></media-placeholder></view></view><view class="detail-description"><view class="usage-rules">{{product.rules}}</view><view class="detail-long-image {{product.detailImage ? 'has-detail-poster' : ''}}"><image wx:if="{{product.detailImage}}" class="detail-poster" src="{{product.detailImage}}" mode="widthFix" lazy-load="{{true}}" aria-label="{{product.name}}商品介绍"></image><media-placeholder wx:else label="商品详情长图待补充" blank="{{true}}" fit="aspectFit"></media-placeholder></view><view class="detail-explanation"><view class="explanation-title">商品说明</view><view class="explanation-copy">{{product.detailDescription || product.desc || '商品说明待补充'}}</view></view><view class="detail-disclaimer">库存、付款人数、价格及奖励积分均为示例数据。项目适用性以专业面诊评估为准。</view></view><view class="bottom-action purchase-toolbar"><view class="toolbar-shortcuts"><button bindtap="support"><ui-icon name="phone" size="44"></ui-icon><text>客服</text></button><button open-type="share"><ui-icon name="arrow" size="44"></ui-icon><text>分享</text></button><button bindtap="goCart"><ui-icon name="cart" size="48"></ui-icon><text>购物车</text></button></view><view class="purchase-buttons"><button class="add-cart" bindtap="add">{{activityMode ? '查看活动' : '加入购物车'}}</button><button class="buy-now" bindtap="buy" disabled="{{submitting}}">{{activityMode === 'group' ? '立即开团' : activityMode === 'flash' ? '立即抢购' : '立即购买'}}</button></view></view></view><view wx:else class="empty"><view class="empty-title">商品不存在</view><text>请返回分类页面重新选择</text></view></view>
