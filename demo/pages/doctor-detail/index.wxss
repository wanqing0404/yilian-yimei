.doctor-detail{padding-bottom:30rpx;background:var(--surface)}
.doctor-detail-content{padding:24rpx 32rpx 28rpx}
.doctor-detail .doctor-profile{padding:28rpx}
.doctor-detail .doctor-profile-top{display:flex;align-items:center;gap:28rpx}
.doctor-detail .doctor-profile-photo{width:190rpx;height:238rpx;border-radius:18rpx;overflow:hidden;flex-shrink:0}
.doctor-detail .doctor-profile-info{flex:1;min-width:0}
.doctor-detail .doctor-profile-name{font-size:40rpx;font-weight:600;color:var(--ink);letter-spacing:1rpx}
.doctor-detail .doctor-profile-title{display:inline-block;color:var(--primary);background:#eef0ff;border-radius:22rpx;padding:5rpx 16rpx;font-size:23rpx;margin-top:12rpx}
.doctor-detail .doctor-experience{display:flex;align-items:center;gap:8rpx;color:#7c879b;font-size:23rpx;margin-top:20rpx}
.doctor-detail .doctor-profile-specialty{color:var(--muted);font-size:23rpx;line-height:1.7;margin-top:10rpx}
.doctor-detail .doctor-section{margin-top:24rpx;padding:28rpx}
.doctor-detail .section-title{font-size:30rpx;font-weight:600;letter-spacing:0}
.doctor-detail .doctor-introduction{font-size:26rpx;line-height:1.95;color:#8b94a5;margin-top:22rpx}
.doctor-detail .doctor-focus-list{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:24rpx}
.doctor-detail .doctor-focus-tag{font-size:23rpx;color:#777ca8;background:#f0f2fc;border-radius:12rpx;padding:12rpx 18rpx}
.doctor-detail .doctor-clinic{display:flex;align-items:center;gap:18rpx;text-align:left;width:100%;margin-top:24rpx}
.doctor-detail .doctor-clinic-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:88rpx;border-radius:16rpx;background:#eff1fc;flex-shrink:0}
.doctor-detail .doctor-clinic-info{flex:1;min-width:0;font-size:21rpx;color:var(--muted);line-height:1.8}
.doctor-detail .doctor-clinic-name{font-size:26rpx;color:#454d5d;font-weight:500;margin-bottom:6rpx}
.doctor-detail .doctor-step{display:flex;gap:20rpx;align-items:flex-start;margin-top:28rpx}
.doctor-detail .doctor-step-number{background:#eff1fc;color:var(--primary);font-size:21rpx;font-weight:600;display:flex;justify-content:center;align-items:center;width:54rpx;height:54rpx;border-radius:50%;flex-shrink:0}
.doctor-detail .doctor-step-title{font-size:26rpx;font-weight:500;color:#4a5364;line-height:1.5}
.doctor-detail .doctor-step-description{font-size:23rpx;line-height:1.7;color:var(--muted);margin-top:5rpx}
.doctor-detail .doctor-demo-note{margin:26rpx 4rpx 0}





.doctor-detail .doctor-certification-title{display:flex;align-items:center;gap:12rpx}.doctor-detail .doctor-certification-status{font-size:21rpx;border-radius:20rpx;padding:6rpx 13rpx;background:#f0f2f7;color:#929aae}.doctor-detail .doctor-certification-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:25rpx;padding:23rpx 0;border-bottom:1rpx solid #f1f3f8;color:#69758b}.doctor-detail .doctor-certification-row>text+text{color:#a5adbc;font-size:23rpx}.doctor-detail .doctor-certification-note{font-size:21rpx;color:#a8afbd;margin-top:20rpx;line-height:1.7}

/* 以等比缩放统一人像构图，保留原图比例。 */
.doctor-photo,.doctor-profile-photo{position:relative;overflow:hidden;background:linear-gradient(135deg,#e8ebf1,#f4f6f9)}
.doctor-portrait{position:absolute;max-width:none!important;width:100%;height:100%;left:0;top:0;object-fit:contain;object-position:center}

.doctor-project-cert{display:flex;align-items:flex-start;gap:14rpx;font-size:24rpx;line-height:1.7;color:#7e8799;margin-top:20rpx}.cert-dot{width:8rpx;height:8rpx;margin-top:17rpx;border-radius:50%;background:#a5acc4;flex-shrink:0}.doctor-memberships{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #f0f2f7;font-size:24rpx;color:#7e8799;line-height:1.9}

.doctor-clinic-tag{display:inline-block;margin:8rpx 0;padding:4rpx 12rpx;border-radius:20rpx;background:#efefff;color:#5655bb;font-size:20rpx}.doctor-schedule-month{margin-top:12rpx;color:#71798b;font-size:24rpx}.doctor-schedule-text{margin-top:10rpx;white-space:pre-line;line-height:1.6}

.schedule-calendar{background:#fff}
.schedule-heading{text-align:center;font-size:30rpx;margin-bottom:18rpx}
.schedule-month{font-size:44rpx;font-weight:650;color:var(--primary);margin-right:8rpx}
.schedule-week,.schedule-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6rpx}
.schedule-week{margin-bottom:8rpx}
.schedule-week text{background:#efefff;color:#5655bb;text-align:center;border-radius:8rpx;padding:6rpx 0;font-size:20rpx}
.schedule-cell{min-height:78rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;border:1rpx solid #edf0f5;border-radius:9rpx;background:#f8f9fb;font-size:21rpx;padding:5rpx 1rpx;text-align:center}
.schedule-cell.outside{visibility:hidden}.schedule-cell.working{background:#efefff;color:#5655bb}.schedule-cell.holiday{background:#e9edf4;color:#515762}.schedule-cell.rest{border:1rpx dashed #cbd2df;color:#788091;background:#f3f5f9}.schedule-detail{font-size:17rpx;overflow-wrap:anywhere}
