.aftercare-page{padding-bottom:180rpx}.care-overview{padding:28rpx;margin-top:24rpx}.care-overview .card-note{margin-top:8rpx}.care-overview-icon{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;border-radius:18rpx;background:#f4f5f9;flex-shrink:0}.care-progress-copy{font-size:23rpx;color:#9aa2b4;margin-top:26rpx}.care-progress-copy text{color:var(--primary);font-weight:500;margin:0 6rpx}.care-progress-track{height:9rpx;border-radius:10rpx;background:#eff1f8;overflow:hidden;margin-top:16rpx}.care-progress-track>view{height:100%;background:var(--primary);border-radius:10rpx}.care-task{display:flex;align-items:center;gap:18rpx;padding:24rpx 0;border-bottom:1rpx solid #f2f4f8;text-align:left;width:100%}.care-task:last-child{border-bottom:0;padding-bottom:0}.care-task-title{font-size:27rpx;color:#545e70;margin-bottom:4rpx}.care-checkbox{width:39rpx;height:39rpx;border:2rpx solid #d9deea;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center}.care-checkbox.checked{border-color:var(--primary);background:#eef0ff}.care-task .card-note{font-size:22rpx}.care-note-input{display:block;box-sizing:border-box;width:100%;height:180rpx;padding:22rpx;margin-top:24rpx;border-radius:16rpx;background:#f6f8fc;font-size:25rpx;line-height:1.8;color:#717c91;border:0}.care-save{width:100%;font-size:25rpx;margin-top:22rpx;padding:18rpx}.care-note-record{margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid #f2f4f8;font-size:25rpx;line-height:1.8;color:#8590a5}.care-note-record text{font-size:22rpx;color:#a0a8b8}.care-note-record>view{white-space:pre-wrap;margin-top:8rpx}
