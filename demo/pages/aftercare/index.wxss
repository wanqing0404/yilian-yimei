.care-search{display:flex;align-items:center;gap:14rpx;margin:16rpx 24rpx;padding:0 22rpx;height:72rpx;border-radius:40rpx;background:#ebeff5}.care-search input{flex:1;font-size:25rpx}.care-layout{display:flex;gap:18rpx;padding:0 20rpx}.care-sidebar,.care-results{height:calc(100vh - 230rpx);min-height:380rpx}.care-sidebar{width:174rpx;flex-shrink:0;background:#eef1f6;border-radius:18rpx}.care-category{width:100%;padding:24rpx 8rpx;font-size:24rpx;color:#667085}.care-category.selected{color:#5355ff;background:white;font-weight:600;border-left:5rpx solid #5355ff}.care-results{flex:1;min-width:0}.care-poster{display:block;width:100%;margin-bottom:18rpx;background:white;overflow:hidden;border-radius:18rpx;text-align:left}.care-poster image,.care-fullscreen image{display:block;width:100%}.care-fullscreen{position:fixed;inset:0;z-index:999;background:#F8F9FB;display:flex;align-items:center}.care-fullscreen-scroll{width:100%;height:100%}.care-close{position:absolute;right:24rpx;top:70rpx;width:72rpx;height:72rpx;border-radius:50%;background:#222c;color:white;font-size:48rpx}
.care-sidebar,.care-results,.care-fullscreen-scroll{overflow-y:auto}.care-poster image,.care-fullscreen image{height:auto}
