<view class="page aftercare-library"><brand-header back="{{true}}" title="术后护理"></brand-header><view class="care-search"><ui-icon name="search" size="32"></ui-icon><input placeholder="搜索项目或护理分类" value="{{keyword}}" bindinput="search" aria-label="搜索护理图片"></input></view><view class="care-layout"><scroll-view scroll-y="{{true}}" class="care-sidebar"><button wx:for="{{categories}}" wx:key="*this" class="care-category {{item === category ? 'selected' : ''}}" data-category="{{item}}" bindtap="select">{{item}}</button></scroll-view><scroll-view scroll-y="{{true}}" class="care-results" scroll-top="{{0}}"><button class="care-poster" wx:for="{{shown}}" wx:key="id" bindtap="open" data-image="{{item.image}}" aria-label="全屏查看{{item.title}}"><image src="{{item.image}}" mode="widthFix" lazy-load="{{true}}"></image></button><view wx:if="{{!shown.length}}" class="empty">没有找到相关护理图片</view></scroll-view></view><view wx:if="{{preview}}" class="care-fullscreen"><scroll-view scroll-y="{{true}}" class="care-fullscreen-scroll"><image src="{{preview}}" mode="widthFix"></image></scroll-view><button class="care-close" bindtap="close" aria-label="关闭全屏">×</button></view></view>
