.welfare-intro{padding:40rpx 0 30rpx}
.welfare-intro .top-title{font-size:42rpx;margin-top:20rpx}
.welfare-note{margin-top:18rpx}
.proof-description{width:100%;background:#f8f9fc;border:1rpx solid #edf0f6;border-radius:14rpx;margin-top:24rpx;padding:20rpx;font-size:24rpx;height:155rpx;box-sizing:border-box}
.proof-upload{background:#f8f9fc;border:1rpx dashed #dfe3ef;border-radius:16rpx;margin:18rpx 0 24rpx;display:flex;flex-direction:column;gap:10rpx;align-items:center;padding:30rpx;color:#969fb3;font-size:24rpx}
.proof-status{padding-top:25rpx;margin-top:25rpx;border-top:1rpx solid #f0f2f7;font-size:23rpx}
.proof-status .between{gap:15rpx}
.lottery-chances,.lottery-result{text-align:center;margin:20rpx 0;font-weight:600;color:var(--primary)}

.lottery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:28rpx 0 20rpx}
.lottery-cell,.lottery-start{display:flex;align-items:center;justify-content:center;min-height:122rpx;padding:10rpx;border-radius:16rpx;text-align:center;font-size:23rpx;line-height:1.4}
.lottery-cell{background:#f3f1ff;color:#524c77;border:2rpx solid transparent}
.lottery-cell-active{background:#ded9ff;border-color:#7262ea;color:#4134a8}
.lottery-start{width:100%;background:var(--primary);color:#fff;font-weight:600}
.lottery-start[disabled]{opacity:.65}
.lottery-pager{font-size:22rpx}
.lottery-pager button{padding:10rpx 20rpx}
