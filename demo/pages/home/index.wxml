<view class="page home"><view class="hero-background"><image wx:if="{{heroImage}}" class="home-hero-portrait {{customHero ? 'home-hero-custom' : ''}}" src="{{heroImage}}" mode="{{customHero ? 'aspectFill' : 'widthFix'}}"></image><media-placeholder wx:else label="首页人物主视觉" kind="hero"></media-placeholder><view class="hero-readability-shade"></view></view><brand-header transparent="{{true}}"></brand-header><view class="hero-copy"><view class="hero-title">让专业<text decode="{{true}}">&#10;</text>定义自然美</view><view class="hero-sub">医学之美 回归本真</view></view><button class="points-card" bindtap="goPoints"><view class="bp">BP</view><view><view class="muted small">美丽积分</view><view class="points-number">{{points}}</view></view><ui-icon name="chevron" size="26"></ui-icon></button><view class="home-content"><view class="home-feature-row"><feature-shortcuts entries="{{shortcuts}}"></feature-shortcuts></view><button class="clinic-banner" bindtap="openEnvironment" aria-label="查看院内环境图片"><view class="clinic-banner-background"><image wx:if="{{clinicImage}}" class="clinic-banner-photo" src="{{clinicImage}}" mode="aspectFill"></image><media-placeholder wx:else label="门店环境图片" kind="interior"></media-placeholder><view class="clinic-banner-shade"></view></view><view class="banner-copy"><view>专业医疗团队<text decode="{{true}}">&#10;</text>定制你的美丽方案</view><view class="banner-bottom"><view class="arrow-circle"><image class="banner-arrow" src="/assets/icons/arrow-white.png" mode="aspectFit"></image></view><text>专业团队 安心变美</text></view></view></button><view class="section-head"><text class="section-title">为你精选</text><button class="more" bindtap="goCategory" data-name="全部项目">全部项目<ui-icon name="chevron" size="24"></ui-icon></button></view><view class="recommend-grid"><view wx:for="{{products}}" wx:key="id" class="recommend-card" data-id="{{item.id}}" bindtap="openProduct"><button class="recommend-image" catchtap="openProduct" data-id="{{item.id}}"><media-placeholder src="{{item.thumbnail}}" label="项目图片" fit="aspectFill" blank="{{true}}" kind="product"></media-placeholder></button><button class="recommend-name" catchtap="openProduct" data-id="{{item.id}}">{{item.name}}</button><view class="between"><text class="price"><text wx:for="{{item.priceParts}}" wx:for-item="part" wx:key="*this" class="{{part === '¥' || part === '积分' || part === '+' ? 'product-price-unit' : ''}}">{{part}}</text></text><button class="circle-button" data-id="{{item.id}}" catchtap="addToCart" aria-label="加入购物车"><ui-icon name="cart" active="{{true}}" size="32"></ui-icon></button></view></view></view></view></view>
