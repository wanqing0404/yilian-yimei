<view class="page service"><brand-header city="{{city}}" bind:citychange="cityChanged"></brand-header><view class="pad"><view class="service-heading">专业医生 定制美丽方案</view><view class="service-sub">正品联盟 · 全程跟踪</view><view class="doctor-deck"><button wx:for="{{doctors}}" wx:key="id" class="doctor-card {{doctorIndex === index ? 'featured' : ''}}" data-id="{{item.id}}" bindtap="openDoctor" aria-label="查看{{item.name}}医生介绍"><view class="doctor-photo"><image class="doctor-portrait portrait-{{item.id}}" src="{{item.image}}" mode="aspectFill"></image></view><view class="doctor-info"><view class="doctor-name">{{item.name}}</view></view></button></view><view class="doctor-dots"><button wx:for="{{doctors}}" wx:key="id" class="dot {{doctorIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectDoctor" aria-label="切换医生"></button></view><view class="section-head"><text class="section-title">门店信息</text><button class="more" bindtap="allClinics">查看全部<ui-icon name="chevron" size="22"></ui-icon></button></view><view class="map-panel"><view class="map-grid clinic-map"><image class="clinic-map-image" src="/assets/images/zhenmei-map-source.png" mode="widthFix" aria-label="医联珍美周边地图截图"></image><view class="clinic-map-tint"></view><text class="map-source-note">高德地图 · 截图示意</text></view><view class="clinic-card"><view class="clinic-photo"><media-placeholder label="门店图片" src="{{clinic.image}}"></media-placeholder></view><view class="clinic-info"><view class="clinic-name">{{clinic.name}}</view><view>{{clinic.address}}</view><view>营业时间 {{clinic.hours}}</view></view><button class="clinic-phone" bindtap="clinicInfo" aria-label="门店联系方式"><ui-icon name="phone" size="34"></ui-icon></button></view></view><button class="primary-button appointment-button" bindtap="openBooking" data-id="{{doctors[doctorIndex].id}}">预约专业咨询</button><view class="notice">医生资料由机构提供，实际坐诊安排以机构确认为准。</view></view></view>
