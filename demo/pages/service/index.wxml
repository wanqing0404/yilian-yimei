<view class="page service"><brand-header></brand-header><view class="pad"><view class="section-head service-doctor-head"><view class="service-heading">专业医生 定制美丽方案</view><button class="more" bindtap="allDoctors">查看全部<ui-icon name="chevron" size="22"></ui-icon></button></view><view class="service-sub">正品联盟 · 全程跟踪</view><view class="doctor-deck" bindtouchstart="startDoctorSwipe" bindtouchend="endDoctorSwipe" bindtouchcancel="cancelDoctorSwipe"><button wx:for="{{visibleDoctors}}" wx:key="id" class="doctor-card {{doctors[doctorIndex].id === item.id ? 'featured' : ''}}" data-id="{{item.id}}" bindtap="openDoctor" aria-label="查看{{item.name}}医生介绍"><view class="doctor-photo"><image wx:if="{{item.image}}" class="doctor-portrait portrait-{{item.id}}" src="{{item.image}}" mode="aspectFit"></image><media-placeholder wx:else label="医生头像" kind="doctor"></media-placeholder></view><view class="doctor-info"><view class="doctor-name">{{item.name}}</view><text wx:if="{{item.clinicTag}}" class="doctor-clinic-tag">{{item.clinicTag}}</text></view></button></view><view class="doctor-dots"><button wx:for="{{doctors}}" wx:key="id" class="dot {{doctorIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectDoctor" aria-label="切换医生"></button></view><view class="section-head"><text class="section-title">院区信息</text><button class="more" bindtap="allClinics">查看全部<ui-icon name="chevron" size="22"></ui-icon></button></view><scroll-view wx:if="{{clinicMaps.length}}" class="clinic-map-scroll" scroll-x="{{true}}" aria-label="横向浏览院区地图">
  <view class="clinic-map-track">
    <view wx:for="{{clinicMaps}}" wx:key="id" class="map-panel clinic-map-slide">
      <view class="map-grid clinic-map">
        <image wx:if="{{item.mapImage}}" class="clinic-map-image" src="{{item.mapImage}}" mode="aspectFill" aria-label="{{item.name}}周边地图"></image>
        <view wx:else class="clinic-map-placeholder"><ui-icon name="pin" active="{{true}}" size="44"></ui-icon><text>院区地图待上传</text></view>
      </view>
      <view class="clinic-card">
        <view class="clinic-photo"><media-placeholder label="院区图片" src="{{item.logo || item.image}}"></media-placeholder></view>
        <button class="clinic-info clinic-details" bindtap="clinicInfo" data-id="{{item.id}}" aria-label="查看{{item.name}}的院区信息"><view class="clinic-name">{{item.name}}</view><view>{{item.address}}</view><view>营业时间 {{item.hours}}</view></button>
        <button class="clinic-phone" bindtap="clinicContact" data-id="{{item.id}}" aria-label="{{item.name}}联系方式"><ui-icon name="phone" size="34"></ui-icon></button>
      </view>
    </view>
  </view>
</scroll-view>
<video wx:if="{{clinic.videoUrl}}" class="clinic-video" src="{{clinic.videoUrl}}" controls="{{true}}"></video>
<view wx:else class="clinic-video clinic-video-empty">门店视频待上传</view>
<view class="notice">医生资料由机构提供，实际坐诊安排以机构确认为准。</view></view></view>
