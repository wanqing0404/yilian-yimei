.service-heading{font-size:38rpx;font-weight:650;letter-spacing:1rpx;margin:38rpx 0 8rpx;white-space:nowrap}.service-sub{font-size:26rpx;color:#929aaa;letter-spacing:3rpx}.doctor-deck{display:flex;gap:14rpx;align-items:flex-start;justify-content:center;margin-top:76rpx;height:330rpx}.doctor-card{width:calc((100% - 28rpx) * .28);background:white;border-radius:16rpx;overflow:hidden;text-align:left;position:relative;flex-shrink:0;transition:transform .2s}.doctor-photo{height:248rpx}.doctor-info{padding:16rpx 10rpx 18rpx}.doctor-name{font-size:24rpx;font-weight:600;white-space:nowrap}.doctor-title{font-size:20rpx;font-weight:400;color:#8c95a6;margin-left:10rpx}.doctor-description{font-size:21rpx;color:#929aaa;line-height:1.5;margin-top:6rpx}.doctor-card.featured{width:calc((100% - 28rpx) * .44);transform:translateY(-42rpx);box-shadow:0 12rpx 30rpx #dbe0eb66}.featured .doctor-photo{height:285rpx}.featured .doctor-info{padding:18rpx}.doctor-dots{display:flex;justify-content:center;gap:14rpx;margin-top:26rpx}.dot{width:12rpx;height:12rpx;border-radius:50%;background:#d5daea}.dot.active{background:var(--primary)}.service .section-head{margin-top:40rpx}.map-panel{border-radius:24rpx;background:#e9edf4;overflow:hidden;padding:0 20rpx 20rpx;position:relative}.map-grid{height:144rpx;position:relative;background:repeating-linear-gradient(40deg,transparent 0,transparent 38rpx,#f8fafc 38rpx,#f8fafc 41rpx),repeating-linear-gradient(-50deg,transparent 0,transparent 64rpx,#f8fafc 64rpx,#f8fafc 67rpx)}.map-position{position:absolute;left:40%;top:32rpx}.map-label{position:absolute;bottom:14rpx;left:8rpx;font-size:20rpx;color:#a2aabb}.clinic-card{display:flex;align-items:center;gap:18rpx;background:rgba(255,255,255,.9);padding:20rpx;border-radius:22rpx}.clinic-photo{height:122rpx;width:138rpx;flex-shrink:0;border-radius:10rpx;overflow:hidden}.clinic-info{flex:1;min-width:0;font-size:20rpx;color:#929aaa;line-height:1.9}.clinic-name{font-size:26rpx;font-weight:600;color:#343945;line-height:1.5}.clinic-phone{background:#edf0f5;border-radius:50%;width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.appointment-button{margin-top:30rpx}

/* 以等比缩放统一人像构图，保留原图比例。 */
.doctor-photo,.doctor-profile-photo{position:relative;overflow:hidden;background:linear-gradient(135deg,#e8ebf1,#f4f6f9)}
.doctor-portrait{position:absolute;max-width:none!important;width:100%;height:100%;left:0;top:0;object-fit:cover;object-position:center top}
.doctor-portrait.portrait-d1{width:180%;height:180%;left:-40%;top:-14%}
.doctor-portrait.portrait-d2{width:120%;height:120%;left:-10%;top:2%}
.doctor-portrait.portrait-d3{width:155%;height:155%;left:-27.5%;top:-6%}

.doctor-info,.featured .doctor-info{padding:18rpx 12rpx;text-align:center}

/* 地图使用用户提供的原始截图，界面内裁切显示并统一冷灰蓝色调。 */
.service .clinic-map{height:244rpx;margin:0 -20rpx;overflow:hidden;background:#e7ebf4}
.service .clinic-map-image{position:absolute;left:0;top:-560rpx;width:100%;height:auto;filter:grayscale(.65) saturate(.35) contrast(.74) brightness(1.08);opacity:.92}
.service .clinic-map-tint{position:absolute;inset:0;background:linear-gradient(180deg,rgba(225,231,244,.1),rgba(233,237,246,.25));pointer-events:none}
.service .map-source-note{position:absolute;left:20rpx;bottom:12rpx;padding:3rpx 8rpx;border-radius:6rpx;background:rgba(246,248,252,.86);color:#8792a7;font-size:17rpx;line-height:1.5}
