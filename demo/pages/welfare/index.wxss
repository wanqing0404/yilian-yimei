.welfare-intro{padding:40rpx 0 30rpx}.welfare-intro .top-title{font-size:42rpx;margin-top:20rpx}.garden{position:relative;text-align:center;padding:50rpx 36rpx 32rpx;overflow:hidden;background:linear-gradient(150deg,#fff,#eef0fa)}.garden-halo{position:absolute;width:300rpx;height:300rpx;border-radius:50%;background:#e3e5f5;left:50%;top:20rpx;transform:translateX(-50%);opacity:.5}.plant{height:260rpx;width:240rpx;margin:0 auto 30rpx;position:relative}.plant-stem{position:absolute;width:8rpx;height:110rpx;left:118rpx;bottom:70rpx;background:#a4adc1;border-radius:4rpx}.plant-leaf{position:absolute;width:65rpx;height:35rpx;bottom:112rpx;background:linear-gradient(120deg,#d4dae6,#98a7b9);border-radius:4rpx 40rpx;transform:rotate(22deg);left:61rpx}.plant-leaf.right{left:123rpx;bottom:140rpx;transform:rotate(-60deg)}.plant-flower{position:absolute;left:76rpx;top:15rpx;width:90rpx;height:90rpx;border-radius:38%;background:linear-gradient(145deg,#fcfcff,#c0bee8);box-shadow:inset 4rpx 4rpx 8rpx #fff,0 8rpx 26rpx #aeb4d433;display:flex;align-items:center;justify-content:center;font-size:30rpx;color:#9a95c6;transform:rotate(-10deg)}.plant-pot{position:absolute;bottom:0;left:64rpx;width:115rpx;height:85rpx;border-radius:10rpx 10rpx 35rpx 35rpx;background:linear-gradient(120deg,#fefeff,#c8cddc);box-shadow:inset 4rpx 0 5rpx #fff,0 15rpx 24rpx #b3bbcd33}.garden-title{font-size:29rpx;font-weight:500;margin-bottom:8rpx}.garden .primary-button{margin-top:28rpx}.checkin-days{display:flex;flex-wrap:wrap;gap:14rpx;margin:28rpx 0}.checkin-day{width:calc((100% - 42rpx)/4);border:1rpx solid #ebeef7;background:#f9faff;border-radius:16rpx;text-align:center;padding:18rpx 5rpx;font-size:21rpx;color:#a3aabd}.checkin-day view{font-size:30rpx;color:#777e96;margin:10rpx 0 2rpx}.checkin-day.done{border-color:#cbc8f6;background:#eeedff}.checkin-day.done view{color:#6e64cd}.progress-number{font-size:48rpx;font-weight:600;color:#6e66d2}.progress-number text{font-size:23rpx;margin-left:10rpx;color:#a1a6b8}.activity-stages{margin-top:20rpx}.activity-stage{display:flex;gap:18rpx;align-items:center;padding:28rpx 0;border-bottom:1rpx solid #f0f2f7}.activity-stage:last-child{border:0}.stage-medal{width:62rpx;height:62rpx;border-radius:50%;background:#f0f2f7;color:#a1a9ba;display:flex;align-items:center;justify-content:center}.lit .stage-medal{background:#eeecff;color:#7162d0}.stage-info{flex:1;font-size:25rpx}.stage-info text{font-size:22rpx;color:#a1a9b9;display:block;margin-top:6rpx}.stage-claim{background:#efedff;border-radius:40rpx;padding:13rpx 19rpx;color:#7b6bd0;font-size:22rpx}.regions{display:flex;flex-wrap:wrap;gap:16rpx}.regions .activity-stage{width:calc((100% - 16rpx)/2);border:1rpx solid #eef0f5;border-radius:18rpx;flex-direction:column;text-align:center;padding:24rpx 10rpx}.regions .lit{background:#f6f4ff;border-color:#ddd7f6}.welfare-note{margin-top:18rpx}.proof-description{width:100%;background:#f8f9fc;border:1rpx solid #edf0f6;border-radius:14rpx;margin-top:24rpx;padding:20rpx;font-size:24rpx;height:155rpx;box-sizing:border-box}.proof-upload{background:#f8f9fc;border:1rpx dashed #dfe3ef;border-radius:16rpx;margin:18rpx 0 24rpx;display:flex;flex-direction:column;gap:10rpx;align-items:center;padding:30rpx;color:#969fb3;font-size:24rpx}.proof-status{padding-top:25rpx;margin-top:25rpx;border-top:1rpx solid #f0f2f7;font-size:23rpx}.proof-status .between{gap:15rpx}.lottery-prizes{display:flex;flex-wrap:wrap;gap:16rpx;margin:25rpx 0}.lottery-prizes view{padding:20rpx 25rpx;border-radius:16rpx;background:#f5f5fc;color:#8d85b6;font-size:25rpx}
