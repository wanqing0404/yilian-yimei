.welfare-intro{padding:40rpx 0 30rpx}
.welfare-intro .top-title{font-size:42rpx;margin-top:20rpx}
.progress-number{font-size:48rpx;font-weight:600;color:#6e66d2}
.progress-number text{font-size:23rpx;margin-left:10rpx;color:#a1a6b8}
.activity-stages{margin-top:20rpx}
.activity-stage{display:flex;gap:18rpx;align-items:center;padding:28rpx 0;border-bottom:1rpx solid #f0f2f7}
.activity-stage:last-child{border:0}
.stage-medal{width:62rpx;height:62rpx;border-radius:50%;background:#f0f2f7;color:#a1a9ba;display:flex;align-items:center;justify-content:center}
.lit .stage-medal{background:#eeecff;color:#7162d0}
.stage-info{flex:1;font-size:25rpx}
.stage-info text{font-size:22rpx;color:#a1a9b9;display:block;margin-top:6rpx}
.stage-claim{background:#efedff;border-radius:40rpx;padding:13rpx 19rpx;color:#7b6bd0;font-size:22rpx}
.regions{display:flex;flex-wrap:wrap;gap:16rpx}
.regions .activity-stage{width:calc((100% - 16rpx)/2);border:1rpx solid #eef0f5;border-radius:18rpx;flex-direction:column;text-align:center;padding:24rpx 10rpx}
.regions .lit{background:#f6f4ff;border-color:#ddd7f6}
.welfare-invite-hero{display:block;width:100%;height:auto;aspect-ratio:1;margin-top:24rpx;border-radius:24rpx}
.invite-friend{padding:18rpx 0;border-bottom:1rpx solid #eef0f5}
.invite-new-button{display:block;width:100%;box-sizing:border-box;margin:24rpx 0}
