<view class="page feature-page welfare-page"><brand-header title="会员福利" back="{{true}}"></brand-header><view class="pad"><view class="feature-tabs"><button class="feature-tab {{tab === 'checkin' ? 'active' : ''}}" data-tab="checkin" bindtap="changeTab">每日签到</button><button class="feature-tab {{tab === 'activity' ? 'active' : ''}}" data-tab="activity" bindtap="changeTab">邀请礼遇</button><button class="feature-tab {{tab === 'lottery' ? 'active' : ''}}" data-tab="lottery" bindtap="changeTab">订单抽奖</button></view><view wx:if="{{connected}}"><view wx:if="{{tab === 'checkin'}}"><view class="welfare-intro"><text class="pill">DAILY MOMENT</text><view class="top-title">每天一点，美丽生长</view><text class="sub-title">签到积累BP，让美好的习惯发芽</text></view><view class="garden panel"><view class="garden-halo"></view><view class="plant"><view class="plant-stem"></view><view class="plant-leaf left"></view><view class="plant-leaf right"></view><view class="plant-flower">{{rules.checkin.theme === 'vegetable' ? '芽' : '花'}}</view><view class="plant-pot"></view></view><view class="garden-title">{{rules.checkin.theme === 'vegetable' ? '我的美丽菜园' : '我的美丽花园'}}</view><view class="card-note">当前积分 {{customer.points}} BP</view><button class="primary-button" bindtap="checkin" disabled="{{busy || customer.checkedInToday || !rules.checkin.enabled}}">{{!rules.checkin.enabled ? '暂未开放' : customer.checkedInToday ? '今日已签到' : rules.checkin.theme === 'vegetable' ? '今日种菜 · 领取积分' : '今日浇花 · 领取积分'}}</button></view><view class="feature-panel panel"><view class="section-title">签到日历</view><view class="checkin-days"><view class="checkin-day {{item.done ? 'done' : ''}}" wx:for="{{days}}" wx:key="day"><text>第{{item.day}}天</text><view>+{{item.points}}</view><text>BP</text></view></view><view class="card-note">{{rules.checkin.mode === 'consecutive' ? '连续签到，中断后从第1天重新开始。' : '累计签到，中断后保留进度。'}}完成周期后重新开始领取。</view></view></view><view wx:if="{{tab === 'activity'}}"><view class="welfare-intro"><text class="pill">BEAUTY TOGETHER</text><view class="top-title">{{rules.activity.title}}</view><text class="sub-title">邀请新顾客到院核销，点亮你的美丽旅程</text></view><view class="feature-panel panel"><view class="between"><text class="section-title">已核销新客</text><text class="progress-number">{{customer.activityProgress}}<text>人</text></text></view><view class="activity-stages {{rules.activity.visual === 'regions' ? 'regions' : ''}}"><view class="activity-stage {{item.lit ? 'lit' : ''}}" wx:for="{{stages}}" wx:key="id"><view class="stage-medal">{{item.lit ? '✓' : index + 1}}</view><view class="stage-info"><view>{{item.name}} · {{item.threshold}}人核销</view><text>奖励 {{item.points}} BP积分</text></view><button class="stage-claim" bindtap="claim" data-id="{{item.id}}" disabled="{{!item.lit || item.claimed || busy || !rules.activity.enabled}}">{{item.claimed ? '已领取' : item.lit ? '立即领取' : '待点亮'}}</button></view></view></view><view class="notice">新顾客以无历史核销记录为准，每位受邀新客只计一次。每个阶段奖励仅限领取一次。</view></view><view wx:if="{{tab === 'lottery'}}"><view class="welfare-intro"><text class="pill">A LITTLE SURPRISE</text><view class="top-title">{{rules.lottery.title}}</view><text class="sub-title">留住每一份期待，收获一份小惊喜</text></view><view class="feature-panel panel" wx:if="{{rules.lottery.requireProof}}"><view class="section-title">提交参与凭证</view><view class="card-note welfare-note">请填写社群订单说明，并上传订单截图。审核通过后可参与抽奖；不符合要求的凭证无法参与。</view><textarea class="proof-description" placeholder="填写订单说明或订单编号" value="{{description}}" bindinput="describe" maxlength="500"></textarea><button class="proof-upload" bindtap="chooseImage"><ui-icon name="image" size="42"></ui-icon><text>{{imageReady ? '截图已选择 · 点击更换' : '上传订单截图'}}</text><text class="small">PNG / JPG / WebP · 3MB以内</text></button><button class="secondary-button" bindtap="submitProof" disabled="{{busy}}">提交审核</button><view class="proof-status" wx:for="{{proofs}}" wx:key="id"><view class="between"><text>{{item.description}}</text><text class="pill">{{item.label}}</text></view><view class="card-note" wx:if="{{item.reviewNote}}">{{item.reviewNote}}</view></view></view><view class="feature-panel panel"><view class="section-title">礼遇奖池</view><view class="lottery-prizes"><view wx:for="{{rules.lottery.prizes}}" wx:key="id">{{item.name}}</view></view><button class="primary-button" bindtap="draw" disabled="{{busy || !rules.lottery.enabled}}">{{rules.lottery.enabled ? '参与抽奖' : '暂未开放'}}</button><view class="card-note welfare-note">{{rules.lottery.maxPerPhone ? '每个手机号限抽' + rules.lottery.maxPerPhone + '次' : '不限制抽奖次数'}} · 本地演示，不发放真实奖品</view><view class="proof-status" wx:for="{{draws}}" wx:key="id"><view class="between"><text>{{item.prizeName}}</text><text class="muted">{{item.status === 'valid' ? '有效' : '已失效'}}</text></view></view></view></view></view><view wx:else class="empty"><view class="empty-title">{{loading ? '正在加载福利' : '后台暂未连接'}}</view><text>{{error}}</text><button wx:if="{{!loading}}" class="secondary-button" bindtap="retry">重新连接</button></view></view></view>
