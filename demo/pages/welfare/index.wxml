<view class="page feature-page welfare-page"><brand-header title="邀请有礼" back="{{true}}"></brand-header><view class="pad"><image class="welfare-invite-hero" src="/assets/images/invite-friends-10bp.jpg" mode="widthFix" aria-label="邀请好友活动海报"></image><view wx:if="{{connected}}"><view class="welfare-intro"><text class="pill">BEAUTY TOGETHER</text><view class="top-title">{{rules.activity.title}}</view><text class="sub-title">好友授权并完成首单后计入活动进度</text></view><view wx:if="{{inviteGuest}}" class="feature-panel panel">
  <view class="section-title">体验受邀流程</view><view class="card-note">同一浏览器内演示授权与首单购买。</view>
  <button wx:if="{{!demoAuthorized}}" class="secondary-button" bindtap="authorizeDemo">模拟新朋友授权</button>
  <button wx:else class="primary-button" bindtap="purchaseDemo" disabled="{{busy}}">选择商品并模拟购买</button>
</view>
<view class="feature-panel panel">
  <view class="section-title">{{rules.activity.friendsLabel || '好友列表'}}</view>
  <view wx:if="{{!customer.invitedFriends.length}}" class="card-note">暂无完成授权和首单的新朋友</view>
  <view wx:for="{{customer.invitedFriends}}" wx:key="id" class="invite-friend between"><text>{{item.name}}</text><text class="pill">已完成首单</text></view>
</view>
<view class="feature-panel panel"><view class="between"><text class="section-title">{{rules.activity.giftsLabel || '邀友礼品'}}</text><text class="progress-number">{{customer.activityProgress}}<text>人</text></text></view><view class="activity-stages {{rules.activity.visual === 'regions' ? 'regions' : ''}}"><view class="activity-stage {{item.lit ? 'lit' : ''}}" wx:for="{{stages}}" wx:key="id"><view class="stage-medal">{{item.lit ? '✓' : index + 1}}</view><view class="stage-info"><view>{{item.name}} · 邀请 {{item.threshold}} 位好友</view><text>{{item.rewardName || (item.points + ' BP 积分')}}</text></view><button class="stage-claim" bindtap="claim" data-id="{{item.id}}" disabled="{{!item.lit || item.claimed || busy || !rules.activity.enabled}}">{{item.claimed ? '已领取' : item.lit ? (rules.activity.claimLabel || '立即领取') : '待点亮'}}</button></view></view></view><button class="primary-button invite-new-button" open-type="share">{{rules.activity.inviteLabel || '邀请新朋友 +'}}</button><view class="notice">每位好友只计一次，每个阶段礼品只可领取一次。</view></view><view wx:else class="empty"><view class="empty-title">{{loading ? '正在加载福利' : '后台暂未连接'}}</view><text>{{error}}</text><button wx:if="{{!loading}}" class="secondary-button" bindtap="retry">重新连接</button></view></view></view>
