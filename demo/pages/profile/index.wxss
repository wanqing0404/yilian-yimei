.profile-row{display:flex;align-items:center;gap:24rpx;padding:38rpx 8rpx 30rpx}.avatar{width:112rpx;height:112rpx;overflow:hidden;border-radius:50%;border:4rpx solid white}.avatar .media-label{font-size:16rpx}.user-info{flex:1;font-size:25rpx}.user-name{font-size:31rpx;font-weight:600;margin-bottom:5rpx}.settings{display:flex;align-items:center;justify-content:center;padding:12rpx}.member-heading button{font-size:21rpx;font-weight:400;display:flex;align-items:center;color:#656b7b}.orders-panel{padding:28rpx 20rpx;margin-top:24rpx}.orders-panel .section-title{font-size:30rpx}.order-types{display:flex;justify-content:space-between;margin-top:34rpx;gap:8rpx}.order-types button{display:flex;align-items:center;flex-direction:column;gap:17rpx;font-size:21rpx;flex:1;white-space:nowrap}.profile-links{margin-top:24rpx;padding:0 24rpx}.profile-link{display:flex;align-items:center;gap:20rpx;padding:26rpx 0;text-align:left;width:100%;border-bottom:1rpx solid #f6f7fb;font-size:26rpx}.profile-link:last-child{border-bottom:0}.link-name{flex:1}.link-value{font-size:24rpx;color:#9da5b5}.profile-footer{text-align:center;font-size:20rpx;color:#b3bac6;margin-top:34rpx}



.member-card{background:linear-gradient(115deg,#d5dbea 0%,#eef0f6 45%,#b9c1d2 78%,#9eabc1 100%);border:1rpx solid #dce0e5;border-radius:26rpx;position:relative;padding:30rpx 30rpx 26rpx;overflow:hidden;min-height:0;box-shadow:inset 0 2rpx 2rpx #ffffffb0,inset 0 -2rpx 3rpx #aeb6c433}.member-star{position:absolute;left:-112rpx;bottom:-152rpx;width:420rpx;height:420rpx;opacity:.32;pointer-events:none}.member-heading{position:relative;display:flex;align-items:center;justify-content:space-between;font-size:31rpx;font-weight:600;color:#343943;z-index:1}.svip{font-size:21rpx;font-weight:400;letter-spacing:1rpx;margin-left:10rpx;color:#6c7482}.member-heading button{display:flex;align-items:center;font-size:21rpx;font-weight:400;color:#727a89;gap:3rpx}.member-assets{position:relative;display:flex;margin-top:34rpx;z-index:1}.member-asset{display:flex;flex:1;min-width:0;flex-direction:column;align-items:flex-start;gap:9rpx;text-align:left;padding-left:26rpx;border-left:1rpx solid #b9c0ca77}.member-asset:first-child{padding-left:0;border-left:0}.member-asset-label{font-size:23rpx;color:#7f8796;font-weight:400}.member-asset-value{font-size:43rpx;line-height:1.25;font-weight:600;letter-spacing:-1rpx;color:#343b47;white-space:nowrap}.member-asset-unit{font-size:20rpx;color:#798392;font-weight:400;margin-left:7rpx;letter-spacing:0}.member-tagline{position:relative;color:#8c94a1;font-size:20rpx;letter-spacing:2rpx;margin-top:28rpx;z-index:1}

.profile-avatar-image{width:100%;height:100%}

.default-avatar{position:relative;width:100%;height:100%;overflow:hidden;border-radius:50%;background:#000;box-shadow:none}.default-avatar-graphic{width:100%;height:100%;display:block}

.member-card-label{font-size:20rpx;font-weight:500;color:#6d778a;background:#ffffff66;border:1rpx solid #ffffff88;border-radius:24rpx;padding:6rpx 16rpx}

