<view class="page profile"><brand-header></brand-header><view class="pad"><view class="profile-row"><view class="avatar"><image wx:if="{{avatarImage}}" class="profile-avatar-image" src="{{avatarImage}}" mode="aspectFill" binderror="avatarError"></image><view wx:else class="default-avatar" aria-label="默认头像"><image class="default-avatar-graphic" src="/assets/decor/default-avatar-dark.png" mode="aspectFit"></image></view></view><view class="user-info"><view class="user-name">{{profile.name}}</view><view class="muted">{{profile.phone}}</view></view><button bindtap="settings" class="settings" aria-label="设置"><ui-icon name="settings" size="40"></ui-icon></button></view><view class="member-card"><image class="member-star" src="/assets/decor/emboss-star.png" mode="aspectFit" aria-hidden="true"></image><view class="member-heading"><text>{{memberLevel}} <text class="svip">{{memberTag}}</text></text><text class="member-card-label">会员礼遇</text></view><view class="member-assets"><button class="member-asset" catchtap="openRecord" data-type="giftbalance"><text class="member-asset-label">赠送余额</text><text class="member-asset-value">{{giftBalance}}</text></button><button class="member-asset" catchtap="openRecord" data-type="points"><text class="member-asset-label">BP积分</text><text class="member-asset-value">{{points}}</text></button><button class="member-asset" catchtap="openRecord" data-type="coupons"><text class="member-asset-label">优惠券</text><text class="member-asset-value">{{couponCount}}<text class="member-asset-unit">张</text></text></button></view></view><view class="orders-panel panel"><view class="between"><text class="section-title">我的订单</text><button class="more" bindtap="openOrders" data-status="全部">全部订单<ui-icon name="chevron" size="22"></ui-icon></button></view><view class="order-types"><button wx:for="{{orderTypes}}" wx:key="status" bindtap="openOrders" data-status="{{item.status}}"><ui-icon name="{{item.icon}}" size="42"></ui-icon><text>{{item.label}}</text></button></view></view><view class="profile-links panel"><button wx:for="{{links}}" wx:key="type" class="profile-link" data-type="{{item.type}}" bindtap="openRecord"><ui-icon name="{{item.icon}}" size="35"></ui-icon><text class="link-name">{{item.label}}</text><text class="link-value">{{item.value}}</text><ui-icon name="chevron" size="24"></ui-icon></button></view><view class="profile-footer">医联·好美 · 让专业定义自然美</view></view></view>
