<view class="page booking"><brand-header back="{{true}}" title="预约咨询"></brand-header><view class="pad" wx:if="{{!success}}"><view class="top-title">开启你的美丽计划</view><view class="sub-title">选择合适的时间，与专业医生聊聊</view><view class="panel booking-panel"><view class="field"><view class="field-title">咨询项目</view><text>{{project}}</text></view><view class="field"><view class="field-title">预约院区</view><text>{{clinic.name}}</text></view><view class="field"><view class="field-title">咨询医生</view><picker range="{{doctors}}" range-key="name" value="{{doctorIndex}}" bindchange="doctorChange"><view class="between">{{doctors[doctorIndex].name}} · {{doctors[doctorIndex].title}}<ui-icon name="chevron" size="26"></ui-icon></view></picker></view><view class="field"><view class="field-title">联系人</view><input placeholder="请输入姓名" maxlength="20" value="{{name}}" data-field="name" bindinput="input"></input></view><view class="field"><view class="field-title">联系电话</view><input placeholder="请输入11位手机号" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="input"></input></view><view class="field"><view class="field-title">预约日期</view><picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="dateChange"><view class="between {{date ? '' : 'muted'}}">{{date || '请选择日期'}}<ui-icon name="calendar" size="30"></ui-icon></view></picker></view><view class="field"><view class="field-title">到院时段</view><picker range="{{times}}" bindchange="timeChange"><view class="between {{time ? '' : 'muted'}}">{{time || '请选择时段'}}<ui-icon name="clock" size="30"></ui-icon></view></picker></view><view class="error-text" wx:if="{{error}}">{{error}}</view></view><view class="notice">演示预约仅保存在当前设备，不会发送给机构。正式上线需接入预约接口与隐私保护流程。</view><button class="primary-button" bindtap="submit" disabled="{{submitting}}">提交演示预约</button></view><view wx:else class="empty"><view class="success-icon"><ui-icon name="check" active="{{true}}" size="66"></ui-icon></view><view class="empty-title">演示预约已保存</view><text>{{date}} {{time}}</text><view>{{clinic.name}}</view><button class="primary-button" bindtap="viewAppointments">查看我的预约</button></view></view>
