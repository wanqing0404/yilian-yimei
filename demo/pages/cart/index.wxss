.cart{padding-bottom:190rpx}.cart-count{font-size:25rpx;font-weight:400;color:#969fb0;margin-left:18rpx}.cart-list{margin-top:38rpx}.cart-card{display:flex;align-items:center;gap:16rpx;padding:24rpx 18rpx;background:white;border-radius:24rpx;margin-bottom:20rpx}.select-circle{width:38rpx;height:38rpx;flex-shrink:0;border:2rpx solid #d6dce6;border-radius:50%;display:flex;align-items:center;justify-content:center}.select-circle.checked{border-color:var(--primary);background:#eef0ff}.cart-image{height:160rpx;width:135rpx;border-radius:14rpx;overflow:hidden;flex-shrink:0}.cart-product{flex:1;min-width:0}.cart-name{font-size:28rpx;font-weight:600;text-align:left}.remove-item{padding:6rpx}.cart-price-line{margin-top:20rpx}.quantity{display:flex;align-items:center;background:#f5f7fb;border-radius:10rpx;height:46rpx;font-size:24rpx}.quantity button{width:44rpx;height:46rpx;display:flex;align-items:center;justify-content:center}.quantity text{min-width:32rpx;text-align:center}.cart-checkout{position:fixed;bottom:0;left:0;right:0;z-index:9;background:white;border-top:1rpx solid #eef1f6;display:flex;align-items:center;gap:18rpx;padding:22rpx 28rpx;padding-bottom:calc(22rpx + env(safe-area-inset-bottom))}.all-select{gap:12rpx;color:#7c8597;font-size:24rpx}.cart-total{flex:1;text-align:right}.cart-checkout .primary-button{font-size:26rpx;padding:20rpx 28rpx;min-width:220rpx}.empty-icon{width:150rpx;height:150rpx;background:#ebeff7;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:auto}.cart-empty{padding-top:150rpx}
