.consult-page{padding-bottom:0}.consult-mode{display:flex;align-items:center;justify-content:center;gap:10rpx;background:#eef1f8;color:#98a0b0;font-size:21rpx;padding:12rpx 20rpx}.consult-questions{display:flex;flex-wrap:wrap;gap:12rpx;padding:24rpx 28rpx 8rpx}.consult-questions button{border:1rpx solid #e1e5f0;background:#fff;color:#8993a9;font-size:22rpx;border-radius:24rpx;padding:10rpx 16rpx}.consult-transcript{height:calc(100vh - 410rpx - 64px);min-height:300rpx;padding:28rpx 24rpx}.consult-message{display:flex;gap:14rpx;align-items:flex-start;margin-bottom:28rpx}.consult-message.user{flex-direction:row-reverse}.consult-avatar{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;background:#fff;border-radius:50%;flex-shrink:0}.consult-bubble{padding:20rpx 24rpx;max-width:calc(100% - 86rpx);font-size:25rpx;line-height:1.9;color:#7f899c;background:#fff;border-radius:4rpx 22rpx 22rpx 22rpx}.consult-message.user .consult-bubble{background:#eeefff;color:#626a9c;border-radius:22rpx 4rpx 22rpx 22rpx}.consult-action{display:flex;align-items:center;gap:8rpx;font-size:24rpx;color:var(--primary);padding-top:18rpx;margin-top:14rpx;border-top:1rpx solid #f0f2f8}.consult-composer{display:flex;align-items:center;gap:16rpx}.consult-input{flex:1;min-width:0;height:78rpx;background:#f3f5f9;border-radius:20rpx;padding:0 24rpx;font-size:25rpx}.consult-send{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:#eef0ff;flex-shrink:0}
