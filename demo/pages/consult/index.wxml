<view class="page feature-page consult-page"><brand-header back="{{true}}" title="在线咨询"></brand-header><view class="consult-mode"><ui-icon name="headset" size="27"></ui-icon><text>本地演示 · 未连接真实客服</text></view><view class="consult-questions"><button wx:for="{{questions}}" wx:key="*this" data-text="{{item}}" bindtap="quick">{{item}}</button></view><scroll-view class="consult-transcript" scroll-y="{{true}}" scroll-into-view="{{scrollTo}}" scroll-with-animation="{{true}}"><view class="consult-message {{item.role}}" id="message-{{item.id}}" wx:for="{{messages}}" wx:key="id"><view class="consult-avatar"><ui-icon name="{{item.role === 'user' ? 'user' : 'headset'}}" active="{{item.role === 'user'}}" size="33"></ui-icon></view><view class="consult-bubble"><text>{{item.content}}</text><button wx:if="{{item.action}}" class="consult-action" data-action="{{item.action}}" bindtap="openAction">{{item.actionLabel}}<ui-icon name="chevron" active="{{true}}" size="21"></ui-icon></button></view></view></scroll-view><view class="bottom-action consult-composer"><input class="consult-input" value="{{draft}}" bindinput="input" bindconfirm="send" placeholder="输入咨询内容" maxlength="200" confirm-type="send"></input><button class="consult-send" bindtap="send" disabled="{{!draft}}" aria-label="发送消息"><ui-icon name="send" active="{{true}}" size="39"></ui-icon></button></view></view>
