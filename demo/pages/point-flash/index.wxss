.point-flash-hero{margin-top:26rpx;padding:36rpx;background:linear-gradient(135deg,#fff,#e8eaf7);position:relative;overflow:hidden}.point-flash-hero .top-title{font-size:45rpx;margin-top:25rpx}.point-flash-hero .sub-title{color:#8e91ab}.flash-schedule{font-size:22rpx;color:#8d87b6;margin-top:26rpx}.flash-count-label{font-size:22rpx;color:#9fa5b9;margin-top:30rpx}.flash-count{font-size:48rpx;color:#6b63c6;font-weight:600;letter-spacing:2rpx;margin:6rpx 0 12rpx}.flash-balance{margin:30rpx 0;font-size:25rpx}.point-flash-grid{display:flex;flex-wrap:wrap;gap:20rpx}.point-flash-card{width:calc((100% - 20rpx)/2);overflow:hidden}.point-flash-image{height:240rpx}.point-flash-copy{padding:23rpx}.flash-gift-name{font-size:27rpx;font-weight:500}.flash-gift-points{font-size:38rpx;color:#7167cc;font-weight:600;margin:18rpx 0 6rpx}.flash-gift-points text{font-size:21rpx;font-weight:400}.flash-gift-button{font-size:23rpx;padding:17rpx 9rpx;margin-top:22rpx}.flash-earn-link{display:flex;align-items:center;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #f0f2f7;width:100%;text-align:left;font-size:26rpx}.flash-earn-link:last-child{border:0}.flash-earn-link text{display:block;color:#9fa7b8;font-size:22rpx;margin-top:7rpx}
