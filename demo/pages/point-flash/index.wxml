<view class="page feature-page point-flash-page"><brand-header title="积分秒杀" back="{{true}}"></brand-header><view class="pad"><view wx:if="{{state}}"><view class="point-flash-hero panel"><text class="pill">POINTS ONLY</text><view class="top-title">{{state.title}}</view><view class="sub-title">这一次，只用积分。</view><view class="flash-schedule">{{state.scheduleMode === 'weekly' ? '每周专场' : '每月专场'}} · 无需现金</view><view class="flash-count-label">{{!state.enabled ? '活动筹备中' : state.active ? '距离本场结束' : '距离下一场开放'}}</view><view class="flash-count">{{state.enabled ? countdown : '敬请期待'}}</view><view class="card-note" wx:if="{{state.enabled}}">{{startLabel}} 开场</view></view><view class="between flash-balance"><text>可用积分 <text class="primary">{{points}} BP</text></text><button class="more" bindtap="records">兑换记录<ui-icon name="chevron" size="22"></ui-icon></button></view><view class="point-flash-grid"><view class="point-flash-card panel" wx:for="{{offers}}" wx:key="id"><view class="point-flash-image"><media-placeholder src="{{item.image}}" fit="aspectFit" blank="{{true}}" kind="product"></media-placeholder></view><view class="point-flash-copy"><view class="flash-gift-name">{{item.name}}</view><view class="flash-gift-points">{{item.points}}<text> BP</text></view><view class="card-note">本场剩余 {{item.remaining}} · 每人限{{item.limit}}件</view><button class="primary-button flash-gift-button" data-id="{{item.id}}" bindtap="redeem" disabled="{{busy || !state.active || item.remaining === 0 || item.claimed >= item.limit || state.claimedCount >= state.maxPerPhone || !item.enough}}">{{!state.active ? '等待开放' : !item.remaining ? '已兑完' : item.claimed >= item.limit ? '已兑换' : !item.enough ? '积分不足' : '立即秒杀'}}</button></view></view></view><view class="feature-panel panel"><view class="section-title">积分从哪里来</view><button class="flash-earn-link" bindtap="goCheckin"><view>每日签到<text>积少成多，为下一场做准备</text></view><ui-icon name="chevron" size="26"></ui-icon></button><button class="flash-earn-link" bindtap="goInvites"><view>邀请新客<text>核销点亮阶段，领取积分</text></view><ui-icon name="chevron" size="26"></ui-icon></button></view><view class="notice">本场每个手机号总限兑换{{state.maxPerPhone}}次。{{state.minCheckins ? '需累计签到'+state.minCheckins+'天。' : ''}}积分与库存以兑换时后台校验为准。活动为本地演示，不产生真实礼品履约。</view><button class="secondary-button" bindtap="refresh">刷新活动</button></view><view wx:else class="empty">{{error || '正在读取活动配置'}}</view></view></view>
