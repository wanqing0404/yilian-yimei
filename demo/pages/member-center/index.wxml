<view class="page feature-page member-center"><brand-header title="会员中心"></brand-header><view class="pad"><view wx:if="{{member}}"><view class="member-pass"><image class="member-pass-star" src="/assets/decor/emboss-star.png" mode="aspectFit" aria-hidden="true"></image><view class="between"><view><text class="member-pass-overline">HAOMEI MEMBERSHIP</text><view class="member-level-name">{{level.name}}<text>{{level.tag}}</text></view></view><button class="member-rules-link" bindtap="growthRules">成长规则<ui-icon name="chevron" size="22"></ui-icon></button></view><view class="member-point-label">当前剩余积分</view><button class="member-point-line" bindtap="pointRecords"><text>{{points}}</text><view>BP<ui-icon name="chevron" size="27"></ui-icon></view></button><view class="member-upgrade" wx:if="{{nextLevel}}"><view class="between"><text>距{{nextLevel.name}}</text><text>还差 {{gapLabel}}</text></view><view class="member-progress"><view style="width:{{progress}}%"></view></view><view class="member-progress-note">{{metricLabel}} {{metricDisplay}}</view></view><view class="member-progress-note" wx:else>已抵达最高等级，尊享当季会员礼遇</view></view><view class="member-level-route"><view wx:for="{{levels}}" wx:key="id" class="member-level-stop {{item.achieved ? 'achieved' : ''}}"><view class="level-node">{{item.current ? '●' : item.achieved ? '✓' : '·'}}</view><text>{{item.name}}</text><view>{{item.thresholdLabel}}</view></view></view><view class="section-head"><text class="section-title">我的专属福利</text><text class="member-season">{{member.season}} · 当季权益</text></view><view class="member-benefit-grid"><view wx:for="{{benefits}}" wx:key="id" class="member-benefit panel {{item.eligible ? '' : 'locked'}}"><view class="member-benefit-icon"><ui-icon name="{{item.type === 'coupon' ? 'coupon' : 'gift'}}" size="37"></ui-icon></view><view class="member-benefit-name">{{item.name}}</view><view class="member-benefit-desc">{{item.description}}</view><view class="member-benefit-count">本季已领 {{item.claimed}}/{{item.quota}} · 已用 {{item.used}}/{{item.quota}}</view><button class="member-benefit-claim" bindtap="claim" data-id="{{item.id}}" disabled="{{busy || !item.eligible || !item.remaining}}">{{!item.eligible ? item.unlockLevel + '解锁' : !item.remaining ? '本季已领取' : '领取福利'}}</button></view></view><view class="feature-panel panel" wx:if="{{records.length}}"><view class="between"><text class="section-title">福利使用情况</text><button class="more" bindtap="coupons">我的礼券<ui-icon name="chevron" size="21"></ui-icon></button></view><view class="member-benefit-record" wx:for="{{records}}" wx:key="id"><view><view>{{item.benefitName}}</view><text>{{item.season}} · {{item.date}}</text></view><text class="pill">{{item.label}}</text></view></view><view class="section-head"><text class="section-title">你的会员旅程</text><button class="more" bindtap="checkin">今日签到<ui-icon name="chevron" size="22"></ui-icon></button></view><view class="feature-panel panel member-journey"><view class="member-journey-stats"><view><text>{{member.earnedPoints}}</text><view>累计获得积分</view></view><view><text>{{member.usedBenefits}}</text><view>已用会员福利</view></view><view><text>{{member.redeemedCount}}</text><view>积分兑换好物</view></view></view><view class="member-journey-row" wx:for="{{journey}}" wx:key="id"><view class="journey-dot {{item.done ? 'done' : ''}}">{{item.done ? '✓' : index + 1}}</view><view><view>{{item.title}}</view><text>{{item.description}}</text></view></view></view><view class="member-shop-entries"><button class="member-shop-card" bindtap="pointsMall"><view><text>积分商城</text><view>积分＋现金，兑换心仪好物</view></view><ui-icon name="chevron" size="26"></ui-icon></button><button class="member-shop-card flash" bindtap="pointFlash"><view><text>积分秒杀日</text><view>每周 / 每月，纯积分专场</view></view><ui-icon name="chevron" size="26"></ui-icon></button></view><view class="section-head"><text class="section-title">{{member.seasonTitle}}</text><button class="more" bindtap="pointsMall">查看全部<ui-icon name="chevron" size="22"></ui-icon></button></view><view class="member-featured-grid"><button class="member-featured panel" wx:for="{{featured}}" wx:key="id" bindtap="pointsMall"><view class="member-featured-image"><media-placeholder src="{{item.image}}" fit="aspectFit" blank="{{true}}" kind="product"></media-placeholder></view><view class="member-featured-copy"><text>{{item.name}}</text><view>{{item.cost}} BP{{item.cashPrice ? ' + ¥' + item.displayCash : ''}}</view></view></button></view><view class="notice">会员等级与权益以机构公示规则为准。当前演示不产生真实扣款或礼品履约。</view></view><view wx:else class="empty">{{error || '正在读取会员资料'}}</view></view></view>
