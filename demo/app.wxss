page{--primary:#5355ff;--ink:#20232b;--muted:#929aaa;--surface:#f6f8fc;background:var(--surface);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:26rpx;line-height:1.5;box-sizing:border-box}view,button,input,textarea,scroll-view{box-sizing:border-box}button{margin:0;padding:0;background:transparent;border-radius:0;font-size:inherit;line-height:inherit;color:inherit}button::after{border:0}button[disabled]{opacity:.45;color:inherit}image{display:block}text{box-sizing:border-box}.page{min-height:100vh;padding-bottom:30rpx}.pad{padding:0 32rpx}.muted{color:var(--muted)}.primary{color:var(--primary)}.section-head{display:flex;justify-content:space-between;align-items:center;margin:32rpx 0 22rpx}.section-title{font-size:32rpx;font-weight:600;letter-spacing:1rpx}.more{display:flex;align-items:center;color:#8991a0;font-size:24rpx;gap:6rpx}.panel{background:white;border-radius:24rpx}.row{display:flex;align-items:center}.between{display:flex;justify-content:space-between;align-items:center}.pill{background:#eef0ff;color:var(--primary);font-size:22rpx;padding:5rpx 14rpx;border-radius:20rpx}.primary-button{background:var(--primary);color:#fff;border-radius:50rpx;padding:24rpx 32rpx;font-size:28rpx;font-weight:500;text-align:center}.secondary-button{border:1rpx solid #dedff0;border-radius:48rpx;padding:20rpx 32rpx;color:var(--primary);text-align:center}.empty{text-align:center;padding:90rpx 32rpx;color:var(--muted)}.empty-title{font-size:30rpx;color:#424956;margin:22rpx 0 10rpx}.empty .primary-button{display:inline-block;margin-top:32rpx;min-width:240rpx}.price{font-family:-apple-system,BlinkMacSystemFont,sans-serif;color:#242631;font-size:34rpx;font-weight:650}.price-symbol{font-size:22rpx;margin-right:2rpx}.hairline{height:1rpx;background:#f1f3f8}.small{font-size:22rpx}.circle-button{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;border-radius:50%;background:#eef0ff}.card-note{font-size:22rpx;color:var(--muted);line-height:1.7}.field{padding:28rpx 0;border-bottom:1rpx solid #f0f2f7}.field-title{margin-bottom:14rpx;color:#5e6678;font-size:24rpx}.field input{height:60rpx;font-size:28rpx;width:100%}.top-title{font-size:44rpx;line-height:1.3;font-weight:600;margin:26rpx 0 10rpx}.sub-title{color:#929aaa;font-size:25rpx}.bottom-action{position:fixed;bottom:0;left:0;right:0;background:white;padding:20rpx 32rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #edf0f5;z-index:10}.notice{font-size:22rpx;color:#929aaa;line-height:1.8;margin:24rpx 0}.error-text{color:#d45c67;font-size:23rpx;margin-top:16rpx}

.feature-page .feature-panel{padding:28rpx;margin-top:24rpx}.feature-page .section-title{font-size:30rpx;letter-spacing:0}.feature-page .feature-body{color:#9099aa;font-size:26rpx;line-height:1.95;margin-top:22rpx}.feature-page .feature-info-row{display:flex;align-items:flex-start;gap:14rpx;color:#929aaa;font-size:24rpx;margin:18rpx 0}.feature-page .campaign-header{padding:30rpx;margin-top:24rpx}.feature-page .campaign-header-label{display:flex;align-items:center;gap:14rpx;font-size:26rpx;color:#7f899c}.feature-page .campaign-countdown{font-size:62rpx;font-weight:600;letter-spacing:5rpx;color:var(--primary);margin:12rpx 0}.feature-page .campaign-offer{padding:26rpx;margin-top:24rpx}.feature-page .campaign-product-row{display:flex;align-items:center;gap:20rpx;text-align:left;width:100%}.feature-page .campaign-photo{width:150rpx;height:172rpx;border-radius:16rpx;overflow:hidden;flex-shrink:0}.feature-page .campaign-product-copy{flex:1;min-width:0}.feature-page .campaign-product-name{font-size:29rpx;font-weight:600;color:#343b49;margin-bottom:9rpx}.feature-page .campaign-stock{font-size:21rpx;color:#9095bf;margin-top:18rpx}.feature-page .campaign-offer-footer{border-top:1rpx solid #f1f3f8;margin-top:24rpx;padding-top:20rpx;gap:18rpx}.feature-page .campaign-deal-price{font-size:43rpx;font-weight:650;color:var(--primary);line-height:1.4}.feature-page .campaign-deal-price>text{font-size:25rpx;margin-right:4rpx}.feature-page .campaign-original{font-size:21rpx;color:#a9b0be;text-decoration:line-through;margin-top:4rpx}.feature-page .campaign-action{font-size:25rpx;padding:18rpx 28rpx;min-width:190rpx;flex-shrink:0}.feature-page .feature-tabs{display:flex;gap:20rpx;padding-top:24rpx}.feature-page .feature-tab{font-size:26rpx;padding:16rpx 22rpx;color:#9aa3b4;border-radius:26rpx;background:#edf0f6}.feature-page .feature-tab.active{background:#ebedff;color:var(--primary);font-weight:500}

.feature-page .personal-empty-icon{width:128rpx;height:128rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#f2f4f8;margin:0 auto 24rpx}.feature-page .personal-empty-action{margin:30rpx auto 0;display:inline-flex;align-items:center;justify-content:center;padding:20rpx 34rpx;font-size:26rpx}.feature-page .personal-link{display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;margin-top:24rpx;padding:28rpx;font-size:27rpx}.feature-page .personal-link .card-note{margin-top:7rpx}
