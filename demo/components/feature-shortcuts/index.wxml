<view class="feature-shortcuts {{expanded ? 'expanded' : ''}}"><button wx:for="{{items}}" wx:key="id" class="feature-shortcut" data-page="{{item.page}}" bindtap="open" aria-label="{{item.label}}"><view class="feature-icon-box"><ui-icon name="{{item.icon}}" size="47"></ui-icon></view><text>{{item.label}}</text></button></view>
