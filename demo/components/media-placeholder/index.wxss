.media{width:100%;height:100%;background:#edf0f5;overflow:hidden;position:relative}.media-image{width:100%;height:100%}.media-label{display:flex;flex-direction:column;justify-content:center;align-items:center;height:100%;gap:12rpx;color:#a5adbc;font-size:20rpx;letter-spacing:1rpx}.hero .media-label{align-items:flex-end;padding-right:62rpx;padding-top:80rpx}.portrait{background:#e8edf6}.portrait .media-label{font-size:18rpx}.interior{background:#e6e9ef}.interior .media-label{align-items:flex-end;padding-right:30rpx}.product{background:#eff2f7}

.media{box-sizing:border-box}.contain-image{object-fit:contain}.media.product{background:linear-gradient(135deg,#edf0f5,#f8f9fc);padding:16rpx}

.media.product.fill-media{padding:0}.fill-media .media-image{object-position:center}
