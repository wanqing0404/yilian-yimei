<view class="page records"><brand-header back="{{true}}" title="{{title}}"></brand-header><view wx:if="{{type === 'orders'}}"><scroll-view scroll-x="{{true}}" class="status-tabs"><view class="status-inner"><button wx:for="{{statuses}}" wx:key="*this" class="status-tab {{status === item ? 'active' : ''}}" bindtap="changeStatus" data-status="{{item}}">{{item}}</button></view></scroll-view><view class="pad"><view wx:for="{{orders}}" wx:key="id" class="panel record-card"><view class="between"><text class="small muted">{{item.id}}</text><text class="primary">{{item.status}}</text></view><view wx:if="{{item.activityName}}" class="order-activity-label"><text class="pill">{{item.activityName}}</text></view><view wx:for="{{item.items}}" wx:for-item="product" wx:key="id" class="order-product"><text>{{product.name}}</text><text class="muted">× {{product.quantity}}</text></view><view class="between"><text class="small muted">{{item.date}}</text><text class="price"><text class="price-symbol">¥</text>{{item.displayTotal}}</text></view><button class="secondary-button order-button" bindtap="orderInfo">查看演示订单</button></view><view wx:if="{{!orders.length}}" class="empty"><view class="empty-title">暂无{{status === '全部' ? '' : status}}订单</view><text>你喜欢的美丽项目在这里等你</text><button class="primary-button" bindtap="goCategory">看看项目</button></view></view></view><view wx:elif="{{type === 'appointments'}}" class="pad"><view wx:for="{{appointments}}" wx:key="id" class="panel record-card"><view class="between"><text class="section-title">{{item.project}}</text><text class="primary">{{item.status}}</text></view><view class="record-description">{{item.date}} {{item.time}}<text decode="{{true}}">&#10;</text>{{item.clinic}} · {{item.doctor}}</view><button wx:if="{{item.status !== '已取消'}}" class="secondary-button" bindtap="cancelAppointment" data-id="{{item.id}}">取消预约</button></view><view wx:if="{{!appointments.length}}" class="empty"><view class="empty-title">还没有预约记录</view><text>从一次专业咨询开始</text><button class="primary-button" bindtap="goService">了解医生与门店</button></view></view><view wx:elif="{{type === 'giftbalance'}}" class="pad"><view class="points-summary panel"><text class="muted">赠送余额（元）</text><view>{{giftBalance}}</view><text class="small muted">赠送余额展示</text></view><view class="empty"><view class="empty-title">暂无余额明细</view><text>机构赠送的余额与使用记录将在这里显示</text></view></view><view wx:elif="{{type === 'points'}}" class="pad"><view class="points-summary panel"><text class="muted">当前BP积分</text><view>{{points}}</view><text class="small muted">积分数据为页面示例</text></view><view class="section-head"><text class="section-title">积分明细</text></view><view class="panel record-card between" wx:for="{{pointTransactions}}" wx:key="id"><view><view>{{item.title}}</view><text class="small muted">本地演示积分记录</text></view><text class="{{item.amount >= 0 ? 'primary' : 'muted'}}">{{item.amountLabel}}</text></view></view><view wx:elif="{{type === 'coupons'}}" class="pad"><view wx:for="{{coupons}}" wx:key="id" class="coupon panel"><view class="coupon-amount"><text>¥</text>{{item.amount}}</view><view><view class="coupon-name">{{item.name}}</view><view class="muted small">{{item.rule}} · 示例优惠券</view></view></view><view wx:if="{{!coupons.length}}" class="empty"><view class="empty-title">还没有可用优惠券</view><text>去领券中心领取一份美丽礼遇</text></view><button class="secondary-button" bindtap="goCouponCenter">前往领券中心</button><view class="notice">已领取优惠券保存在当前设备，真实订单核销待接入。</view></view><view wx:elif="{{type === 'clinics'}}" class="pad"><view wx:for="{{clinics}}" wx:key="id" class="panel record-card"><view class="section-title">{{item.name}}</view><view class="record-description">{{item.address}}<text decode="{{true}}">&#10;</text>营业时间 {{item.hours}}</view><button class="secondary-button" bindtap="goService">查看服务</button></view></view><view wx:elif="{{type === 'settings'}}" class="pad"><view class="panel settings-panel"><button bindtap="about" class="settings-row">关于医联·好美<ui-icon name="chevron" size="26"></ui-icon></button><button bindtap="reset" class="settings-row">清除本地演示数据<ui-icon name="chevron" size="26"></ui-icon></button></view><view class="notice">当前框架不采集微信用户资料，不接入真实登录、交易或机构系统。</view></view></view>
