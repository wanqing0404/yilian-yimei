.group-status{padding:36rpx 28rpx;margin-top:24rpx;text-align:center}.group-status-icon{margin:auto auto 18rpx;width:106rpx;height:106rpx;border-radius:50%;background:#eef0ff;display:flex;justify-content:center;align-items:center}.group-status-title{font-size:33rpx;font-weight:600;margin-bottom:10rpx}.group-status>.muted{font-size:24rpx}.group-members{display:flex;justify-content:center;gap:54rpx;margin:38rpx 0 30rpx}.group-member{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;font-size:22rpx;color:#7d87a1;width:110rpx;height:110rpx;border:2rpx solid #d9def5;border-radius:50%;background:#f7f8ff}.group-member.waiting{border-style:dashed;background:#fafbfe}.group-item-name{font-size:30rpx;font-weight:500;margin-bottom:10rpx}.group-price-unit{font-size:22rpx!important;color:#9aa3b4!important}.group-expiry{margin:16rpx 0 30rpx}.group-invite,.group-simulate{width:100%;margin-top:16rpx}.group-simulate{font-size:25rpx}.group-record{padding:28rpx;margin-top:24rpx;width:100%;text-align:left}.group-record-name{font-size:28rpx;font-weight:500}.group-record-meta{font-size:24rpx;color:#9aa3b4;margin-top:26rpx}

.group-list-intro{padding:30rpx 6rpx 6rpx}.group-list-intro>view{font-size:38rpx;font-weight:600;color:#333b4b}.group-list-intro>text{display:block;color:#9aa4b7;font-size:24rpx;margin-top:6rpx}.group-offer-card{padding:24rpx;margin-top:24rpx}.group-offer-product{display:flex;align-items:stretch;gap:22rpx;text-align:left;width:100%}.group-offer-photo{width:174rpx;height:188rpx;border-radius:16rpx;overflow:hidden;flex-shrink:0}.group-offer-copy{flex:1;min-width:0;display:flex;flex-direction:column}.group-offer-title{font-size:27rpx;line-height:1.6;color:#454d5c;font-weight:500}.group-offer-price-row{display:flex;align-items:center;gap:10rpx;margin-top:auto;padding-top:22rpx;flex-wrap:wrap}.group-people-badge{color:var(--primary);font-size:21rpx;background:#edf0ff;padding:3rpx 9rpx;border-radius:8rpx;white-space:nowrap}.group-offer-price{font-size:36rpx;font-weight:650;line-height:1.2;letter-spacing:-.5rpx;color:var(--primary);white-space:nowrap}.group-offer-price>text{font-size:23rpx;margin-right:3rpx}.group-offer-joined{color:#9da5b4;font-size:23rpx;margin-top:9rpx}.group-offer-bottom{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:22rpx}.group-offer-remaining{display:flex;align-items:center;gap:4rpx;color:#a0a8b8;font-size:19rpx;white-space:nowrap;min-width:0}.group-time-cell{display:inline-flex;align-items:center;justify-content:center;background:#f0f2f7;color:#626c7f;border-radius:7rpx;padding:4rpx 5rpx;min-width:30rpx;font-size:21rpx;font-weight:500}.group-open-button{padding:16rpx 24rpx;min-width:155rpx;font-size:25rpx;flex-shrink:0}.group-record-name{max-width:72%;font-size:26rpx}.group-status-title{font-size:31rpx}
