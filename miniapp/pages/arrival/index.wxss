.arrival-page{padding-bottom:180rpx}.arrival-map{height:220rpx;border-radius:18rpx;margin:28rpx 0;background:repeating-linear-gradient(40deg,transparent 0,transparent 40rpx,#fff 40rpx,#fff 43rpx),repeating-linear-gradient(-50deg,#eef1f6 0,#eef1f6 68rpx,#fff 68rpx,#fff 71rpx);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12rpx;color:#a0a8b6;font-size:22rpx}.arrival-step{display:flex;align-items:flex-start;gap:20rpx;margin-top:30rpx}.arrival-step-number{width:54rpx;height:54rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#eff1fb;color:var(--primary);font-size:21rpx;font-weight:600}.arrival-step-title{font-size:27rpx;color:#5c6678;margin-bottom:6rpx}.arrival-appointments{margin-top:24rpx;width:100%;padding:28rpx;display:flex;align-items:center;justify-content:space-between;text-align:left;font-size:28rpx}
