.member-pass{margin-top:25rpx;padding:32rpx;border-radius:26rpx;background:linear-gradient(115deg,#d5dbea,#eef0f6 45%,#b9c1d2 78%,#9eabc1);position:relative;overflow:hidden;color:#3a4253;box-shadow:inset 1rpx 1rpx 2rpx #fff}.member-pass-overline{font-size:16rpx;letter-spacing:4rpx;color:#8d97ab}.member-level-name{font-size:34rpx;font-weight:600;margin-top:12rpx}.member-level-name text{font-size:22rpx;margin-left:16rpx;font-weight:500}.member-rules-link{display:flex;align-items:center;gap:4rpx;font-size:21rpx;color:#68758c}.member-point-label{font-size:23rpx;color:#8792a7;margin-top:38rpx}.member-point-line{display:flex;align-items:center;gap:16rpx;margin:6rpx 0 28rpx}.member-point-line>text{font-size:68rpx;font-weight:600;line-height:1.3;letter-spacing:-1rpx}.member-point-line>view{display:flex;align-items:center;font-size:23rpx;gap:18rpx;color:#8490a6}.member-upgrade{border-top:1rpx solid #fff5;padding-top:24rpx;font-size:23rpx;color:#727e94}.member-progress{height:7rpx;background:#fff6;border-radius:4rpx;margin:18rpx 0 10rpx;overflow:hidden}.member-progress>view{height:100%;background:#8a91b5;border-radius:4rpx;min-width:4rpx}.member-progress-note{font-size:20rpx;color:#929cb0}.member-level-route{display:flex;margin:28rpx 0 38rpx}.member-level-stop{flex:1;text-align:center;font-size:20rpx;color:#a5adbc;position:relative}.member-level-stop:before{content:'';height:1rpx;background:#e0e5ef;position:absolute;top:18rpx;left:50%;width:100%}.member-level-stop:last-child:before{display:none}.level-node{position:relative;z-index:1;width:36rpx;height:36rpx;border-radius:50%;background:#eef1f7;margin:0 auto 12rpx;color:#a6adbd;display:flex;align-items:center;justify-content:center}.achieved .level-node{background:#e6e4fa;color:#877dc1}.achieved>text{color:#7e78aa}.member-level-stop>view:last-child{font-size:16rpx;margin-top:5rpx}.member-season{font-size:20rpx;color:#a3adbf}.member-benefit-grid{display:flex;gap:18rpx;flex-wrap:wrap}.member-benefit{padding:26rpx;width:calc((10