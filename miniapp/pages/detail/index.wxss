.product-detail{background:var(--surface);padding-bottom:190rpx}.detail-gallery{height:520rpx;position:relative;margin:24rpx 32rpx 0;border-radius:24rpx;overflow:hidden}.gallery-counter{position:absolute;right:24rpx;bottom:20rpx;background:#fff;color:#8d96a7;border-radius:24rpx;padding:3rpx 18rpx;font-size:22rpx;line-height:1.5}.product-summary{background:#fff;padding:30rpx;margin:24rpx 32rpx 0;border-radius:24rpx}.detail-price{font-size:50rpx;font-weight:650;color:var(--ink);letter-spacing:-1rpx;line-height:1.3}.currency{font-size:27rpx;margin-right:5rpx;font-weight:600}.stock{color:var(--primary);background:#eef0ff;border-radius:24rpx;padding:6rpx 16rpx;font-size:22rpx;white-space:nowrap}.paid{font-size:23rpx;color:var(--muted);margin-top:10rpx}.detail-name{font-size:32rpx;font-weight:600;line-height:1.5;margin-top:24rpx;color:var(--ink)}.invite-section{display:flex;align-items:center;justify-content:space-between;padding:28rpx;background:white;margin:24rpx 32rpx 0;border-radius:24rpx;gap:18rpx}.invite-title{font-size:30rpx;font-weight:600;color:var(--ink)}.invite-description{font-size:23rpx;color:var(--muted);margin:8rpx 0 22rpx}.invite-description text{color:var(--primary);margin-left:4rpx}.invite-button{display:block;padding:12rpx 30rpx;border-radius:44rpx;background:var(--primary);color:white;font-size:25rpx;font-weight:500}.invite-art{width:178rpx;height:156rpx;border-radius:16rpx;overflow:hidden;flex-shrink:0}.detail-description{background:white;margin:24rpx 32rpx 0;padding:28rpx;border-radius:24rpx}.usage-rules{font-size:25rpx;line-height:1.8;color:#697286}.detail-long-image{height:190rpx;margin-top:24rpx;border-radius:16rpx;overflow:hidden}.detail-explanation{padding:30rpx 0 18rpx;color:var(--muted);font-size:25rpx;line-height:1.9}.explanation-title{font-size:30rpx;font-weight:600;color:var(--ink);margin-bottom:12rpx}.detail-disclaimer{font-size:21rpx;color:#a7afbf;line-height:1.8;padding:16rpx 0 0;border-top:1rpx solid #f1f3f8}.purchase-toolbar{display:flex;align-items:center;gap:20rpx;padding:20rpx 26rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #edf0f5;background:#fff;border-radius:24rpx 24rpx 0 0}.toolbar-shortcuts{display:flex;align-items:center;justify-content:space-between;width:230rpx;flex-shrink:0;gap:6rpx}.toolbar-shortcuts button{display:flex;flex-direction:column;align-items:center;gap:5rpx;color:#8b94a5;font-size:21rpx;flex:1}.purchase-buttons{display:flex;align-items:center;height:84rpx;flex:1;min-width:0;gap:14rpx}.purchase-buttons button{height:100%;flex:1;font-size:25rpx;font-weight:500;display:flex;justify-content:center;align-items:center;white-space:nowrap;border-radius:46rpx;padding:0 12rpx}.add-cart{background:#eef0ff;color:var(--primary)}.buy-now{background:var(--primary);color:#fff}

.detail-activity-label{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:22rpx}.detail-activity-label>.muted{text-decoration:line-through}


.detail-deposit-label{font-size:26rpx;font-weight:500;margin-right:8rpx}
