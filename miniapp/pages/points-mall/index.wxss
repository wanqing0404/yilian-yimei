.points-mall-balance{display:flex;align-items:center;justify-content:space-between;padding:28rpx 30rpx;margin-top:24rpx}.points-mall-number{font-size:65rpx;color:var(--primary);font-weight:600;line-height:1.4}.points-gift{display:flex;align-items:center;gap:20rpx;padding:24rpx;margin-top:24rpx}.points-gift-photo{width:135rpx;height:164rpx;border-radius:16rpx;overflow:hidden;flex-shrink:0}.points-gift-copy{flex:1;min-width:0}.points-gift-name{font-size:28rpx;font-weight:500}.points-gift-cost{font-size:34rpx;font-weight:600;color:var(--primary);margin-top:18rpx}.points-gift-cost text{font-size:21rpx;font-weight:400}.points-redeem{background:var(--primary);color:#fff;font-size:22rpx;border-radius:30rpx;padding:14rpx 20rpx;white-space:nowrap;flex-shrink:0}.points-redeem[disabled]{background:#eef0f6;color:#8c95a8;opacity:1}.points-record{padding:28rpx;margin-top:24rpx}.points-record-meta{color:#8b94aa;font-size:24rpx;margin:22rpx 0 12rpx}
