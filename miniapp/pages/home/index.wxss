.home{position:relative}.hero-background{position:absolute;top:0;left:0;right:0;height:880rpx;overflow:hidden;background:#edf0f5}.hero-copy{position:absolute;z-index:1;top:410rpx;left:38rpx}.hero-title{font-family:inherit;font-weight:600;font-size:43rpx;line-height:1.4;letter-spacing:2rpx}.hero-sub{color:#939ba8;margin-top:16rpx;font-size:25rpx;letter-spacing:2rpx}.points-card{position:absolute;left:34rpx;top:658rpx;display:flex;align-items:center;gap:18rpx;padding:19rpx 24rpx;border-radius:24rpx;background:rgba(255,255,255,.78);width:330rpx;text-align:left}.bp{width:62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(140deg,#f4f6f9,#d7dde6);color:#6a7485;border:1rpx solid #ffffffcc;border-radius:10rpx;font-size:25rpx;font-weight:600;box-shadow:inset 0 1rpx 2rpx #ffffffaa;flex-shrink:0}.points-number{font-size:40rpx;font-weight:650;line-height:1.15}.home-content{position:relative;z-index:2;margin-top:668rpx;background:#fff;border-radius:38rpx 38rpx 0 0;padding:26rpx 24rpx 34rpx}.clinic-banner{height:260rpx;border-radius:22rpx;overflow:hidden;position:relative;text-align:left}.banner-copy{position:absolute;top:36rpx;left:32rpx;font-size:34rpx;line-height:1.4}.banner-bottom{display:flex;align-items:center;gap:20rpx;color:#7e8798;font-size:24rpx;margin-top:24rpx}.arrow-circle{display:flex;align-items:center;justify-content:center;border:1rpx solid #a9b0bc;width:48rpx;height:48rpx;border-radius:50%}.recommend-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx}.recommend-card{background:#f7f9fc;border-radius:18rpx;padding:12rpx}.recommend-image{height:240rpx;width:100%;border-radius:12rpx;overflow:hidden}.recommend-name{font-size:28rpx;font-weight:500;text-align:left;padding:18rpx 0 14rpx}

.clinic-banner{width:100%}.hero-title text,.banner-copy text{white-space:pre-line}

.home-feature-row{padding:4rpx 0 28rpx;margin-bottom:0;border-bottom:0}

.home-hero-portrait{position:absolute;width:135%;height:auto;max-width:none;left:-26.5%;top:-6%}.hero-readability-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(237,240,245,.96) 0%,rgba(237,240,245,.55) 23%,rgba(237,240,245,0) 48%);pointer-events:none}

.clinic-banner-background{position:absolute;inset:0;background:#e4e7ed}.clinic-banner-photo{width:100%;height:100%}.clinic-banner-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(218,223,232,.98) 0%,rgba(225,229,236,.92) 30%,rgba(230,233,239,.46) 52%,rgba(230,233,239,0) 72%)}.banner-copy{font-size:35rpx;font-weight:500;color:#303846;z-index:1}.banner-bottom{font-weight:400;color:#8c95a6}.arrow-circle{background:#252d37;border:0;box-shadow:0 2rpx 5rpx #00000016}.banner-arrow{width:28rpx;height:28rpx}

.home-welfare{display:flex;margin:26rpx 0 10rpx;background:#fafbff;border:1rpx solid #f0f1f8;border-radius:20rpx;padding:26rpx 0}.home-welfare button{flex:1;text-align:left;padding:0 20rpx;border-right:1rpx solid #eaeef5;font-size:25rpx;font-weight:500}.home-welfare button:last-child{border:0}.home-welfare button view{color:#a0a8ba;font-size:20rpx;font-weight:400;margin-top:8rpx}
