.search-wrap{display:flex;align-items:center;gap:18rpx;height:72rpx;margin:22rpx 32rpx 18rpx;padding:0 28rpx;background:#ebeff5;border-radius:40rpx}.search-input{flex:1;min-width:0;height:72rpx;font-size:24rpx}.search-clear{display:flex;padding:10rpx}.category-top-nav{width:100%;white-space:nowrap;border-bottom:1rpx solid #e9edf5;margin-bottom:24rpx}.category-top-inner{display:flex;align-items:center;padding:0 20rpx;min-width:100%;width:max-content}.category-item{position:relative;display:inline-flex;align-items:center;justify-content:center;padding:0 24rpx;height:88rpx;flex-shrink:0;color:#8d96a7;font-size:26rpx;white-space:nowrap}.category-item.selected{color:var(--primary);font-weight:600}.category-item.selected::after{content:'';position:absolute;left:calc(50% - 18rpx);bottom:0;width:36rpx;height:5rpx;border-radius:6rpx;background:var(--primary)}.catalogue{padding:0 28rpx}.product-scroll{width:100%;height:calc(100vh - 300rpx - 88px);min-height:500rpx}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx}.product-card{background:#fff;border-radius:18rpx;overflow:hidden}.product-image{height:300rpx;width:100%}.product-info{padding:18rpx 18rpx 16rpx}.product-name{text-align:left;font-size:27rpx;font-weight:600;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;max-width:100%}.product-desc{font-size:22rpx;color:#929aaa;line-height:1.6;margin:7rpx 0 20rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.price{font-size:34rpx}.cart-button{border-radius:50%;background:#eef0ff;width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.catalogue-end{text-align:center;color:#b0b7c4;font-size:21rpx;padding:32rpx 0}.category .empty{padding-left:10rpx;padding-right:10rpx}.category .empty ui-icon{display:flex;justify-content:center}

.category-item.selected::after{top:auto;right:auto;transform:none;transform-origin:center;box-sizing:border-box}

.category-top-nav{overflow-x:auto;overflow-y:hidden;scrollbar-width:none;touch-action:pan-x}.category-top-nav::-webkit-scrollbar{display:none}.category-top-inner{display:inline-flex;vertical-align:top}.product-scroll{touch-action:pan-y}

.category-nav-row{display:flex;align-items:stretch;width:100%;border-bottom:1rpx solid #e9edf5;margin-bottom:24rpx}.category-all{width:112rpx;margin-left:16rpx;flex-shrink:0;background:#f6f8fc}.category-nav-row .category-top-nav{flex:1;width:0;min-width:0;border-bottom:0;margin-bottom:0}.category-nav-row .category-top-inner{padding-left:4rpx;padding-right:20rpx}

.product-image{height:370rpx}

.deposit-label{font-size:20rpx;color:#8991a5;margin-right:8rpx;white-space:nowrap}
