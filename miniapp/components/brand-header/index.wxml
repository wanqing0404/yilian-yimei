<view class="header {{transparent ? 'transparent' : ''}}" style="padding-top:{{statusBarHeight}}px"><view class="header-content" style="height:{{navHeight}}px;padding-right:{{navRight}}px"><button wx:if="{{back}}" class="back" bindtap="goBack" aria-label="返回"><ui-icon name="back" size="36"></ui-icon></button><view wx:if="{{!title && !back}}" class="brand"><text>医联·好美</text></view><text wx:if="{{title}}" class="header-title">{{title}}</text><button wx:if="{{city}}" class="city" bindtap="chooseCity">{{city}}<text class="caret"></text></button></view></view>
