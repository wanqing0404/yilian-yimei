.header{position:relative;z-index:5;background:#f6f8fc}.transparent{background:transparent}.header-content{display:flex;align-items:center;padding-left:32rpx;gap:20rpx}.brand{display:flex;align-items:center;gap:14rpx;font-weight:600;font-size:31rpx;white-space:nowrap;letter-spacing:-.5rpx}.city{display:flex;align-items:center;gap:10rpx;font-size:24rpx;color:#71798a;white-space:nowrap}.caret{display:block;width:10rpx;height:10rpx;border:1.5rpx solid #8d95a4;border-top:0;border-left:0;transform:rotate(45deg);margin-top:-5rpx}.back{display:flex;align-items:center;justify-content:center;width:42rpx;height:60rpx;margin-left:-12rpx}.header-title{font-size:31rpx;font-weight:600}
